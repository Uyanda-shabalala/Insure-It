# Server-side destination for device, lookup, employee and lifecycle API calls.
# Keep Spring Boot on a different port from the frontend (normally 3000).
API_BACKEND_ORIGIN=http://127.0.0.1:8080

# Preserve the existing OCR destination; it may differ from the asset API.
OCR_BACKEND_ORIGIN=http://127.0.0.1:8080

# Optional browser base and lookup paths (defaults shown).
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
# NEXT_PUBLIC_API_BASE_URL=/api
# NEXT_PUBLIC_BRANDS_PATH=/brands
# NEXT_PUBLIC_DEVICE_TYPES_PATH=/device-types
# NEXT_PUBLIC_EMPLOYEES_PATH=/employees

# Defaults match the integrated assignment/return endpoints.
# NEXT_PUBLIC_DEVICE_ASSIGN_PATH=/devices/{id}/assign
# NEXT_PUBLIC_DEVICE_RETURN_PATH=/devices/{id}/return

# Never place API credentials, service-role keys or other secrets in public vars.
